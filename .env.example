# Copy this file to .env and replace every placeholder before running Docker Compose.
BINHU_MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
BINHU_MYSQL_USER=binhu
BINHU_MYSQL_PASSWORD=replace-with-a-strong-application-password
BINHU_ENCRYPTION_KEY=replace-with-a-random-application-key
# Optional dedicated HMAC key for exact RegistryData matching. If empty, the
# application key is used only as a staged-deployment fallback.
BINHU_REGISTRY_HMAC_KEY=
BINHU_DOMAIN_DATABASES_ENABLED=true
BINHU_PLATFORM_DOMAIN_ACTIVE=false
BINHU_VISIT_DOMAIN_ACTIVE=false
BINHU_DISPATCH_DOMAIN_ACTIVE=false
BINHU_DAILY_DOMAIN_ACTIVE=false
BINHU_REGISTRY_ADDRESS_DOMAIN_ACTIVE=false
BINHU_REGISTRY_FEATURE_ENABLED=false
BINHU_WORKFLOW_FEATURE_ENABLED=false
BINHU_WINDOWS_MIN_SUPPORTED_VERSION=0.0.0
BINHU_ANDROID_MIN_SUPPORTED_VERSION=0.0.0
BINHU_CLIENT_WRITE_VERSION_ENFORCEMENT_ENABLED=true
BINHU_CLIENT_WRITE_IDENTIFICATION_REQUIRED=false
BINHU_TXDOCS_DAILY_REQUEST_LIMIT=20000
BINHU_SESSION_COOKIE_SECURE=true
BINHU_SESSION_COOKIE_SAMESITE=none
BINHU_MULTI_DEVICE_SESSION_ENABLED=true
BINHU_CORS_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,binhu://app

# Required only when starting with an empty _users table. Remove after first login.
BINHU_BOOTSTRAP_ADMIN_USERNAME=
BINHU_BOOTSTRAP_ADMIN_PASSWORD=
BINHU_OPS_AGENT_TOKEN=replace-with-a-second-random-application-key
BINHU_BACKUP_DIR=./backups
BINHU_WORKFLOW_ATTACHMENT_DIR=/data/binhu/workflow-attachments
BINHU_WORKFLOW_PHOTO_IMPORT_DIR=/data/binhu/workflow-photo-imports
BINHU_USER_AVATAR_DIR=/data/binhu/user-avatars
BINHU_FULLCHAIN_ARCHIVE_DIR=/data/binhu/fullchain-archives
BINHU_POLICE_DISPATCH_IMPORT_DIR=/data/binhu/police-dispatch-imports

# Internal visit/rating source acquisition. Keep URL empty until a redacted
# Configure these only on the server. Username/password are used for the
# verified read-only login flow when a static authorization token is absent.
BINHU_VISIT_SOURCE_BASE_URL=
BINHU_VISIT_SOURCE_AUTHORIZATION=
BINHU_VISIT_SOURCE_USERNAME=
BINHU_VISIT_SOURCE_PASSWORD=
BINHU_VISIT_SOURCE_DETAIL_FIELD_MAP=
BINHU_VISIT_SOURCE_RATING_FIELD_MAP=
BINHU_VISIT_SOURCE_MOCK=false
BINHU_VISIT_SOURCE_AUTO_CONFIRM=false
# 房东责任告知书图片只读目录，例如内部静态文件服务的 signatures 目录。
BINHU_CERTIFICATE_IMAGE_BASE_URL=
BINHU_CERTIFICATE_SOURCE_DAILY_ENABLED=false
BINHU_CERTIFICATE_SOURCE_DAILY_TIME=02:30

# 全民防模型三单条只读预演。敏感项只在生产服务器填写，禁止提交真实值。
# 完成一次登录及四条只读接口验证后，才可同时开启 ENABLED 和
# LOGIN_PROTOCOL_VERIFIED。IMEI/MACHINE_UID 必须是已明确授权的专用设备标识。
BINHU_QMF_PREVIEW_ENABLED=false
BINHU_QMF_API_BASE_URL=
BINHU_QMF_LOGIN_HOST=
BINHU_QMF_LOGIN_PORT=0
BINHU_QMF_SOURCE_USERNAME=
BINHU_QMF_SOURCE_PASSWORD=
BINHU_QMF_SOURCE_IMEI=
BINHU_QMF_SOURCE_MACHINE_UID=
BINHU_QMF_EXPECTED_STATION_CODE=320584710000
BINHU_QMF_EXPECTED_STATION_NAME=滨湖新城派出所
BINHU_QMF_TIMEOUT_SECONDS=15
BINHU_QMF_PREVIEW_COOLDOWN_SECONDS=45
BINHU_QMF_LOGIN_PROTOCOL_VERIFIED=false
BINHU_QMF_STATUS_SCAN_ENABLED=false
BINHU_QMF_STATUS_SCAN_TIME=

# Required only by the remote deployment helper scripts.
BINHU_SSH_HOST=your-server.example.com
BINHU_SSH_PORT=22
BINHU_SSH_USER=root
BINHU_SSH_PASSWORD=replace-with-your-ssh-password
BINHU_LOCAL_BASE=.
