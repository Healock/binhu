# Copy this file to .env and replace every placeholder before running Docker Compose.
BINHU_MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
BINHU_MYSQL_USER=binhu
BINHU_MYSQL_PASSWORD=replace-with-a-strong-application-password
BINHU_ENCRYPTION_KEY=replace-with-a-random-application-key
# Optional dedicated HMAC key for exact RegistryData matching. If empty, the
# application key is used only as a staged-deployment fallback.
BINHU_REGISTRY_HMAC_KEY=
BINHU_DOMAIN_DATABASES_ENABLED=true
BINHU_PLATFORM_DOMAIN_ACTIVE=false
BINHU_VISIT_DOMAIN_ACTIVE=false
BINHU_DISPATCH_DOMAIN_ACTIVE=false
BINHU_DAILY_DOMAIN_ACTIVE=false
BINHU_REGISTRY_ADDRESS_DOMAIN_ACTIVE=false
BINHU_REGISTRY_FEATURE_ENABLED=false
BINHU_WORKFLOW_FEATURE_ENABLED=false
BINHU_SESSION_COOKIE_SECURE=true
BINHU_CORS_ALLOWED_ORIGINS=https://your-public-host

# Required only when starting with an empty _users table. Remove after first login.
BINHU_BOOTSTRAP_ADMIN_USERNAME=
BINHU_BOOTSTRAP_ADMIN_PASSWORD=
BINHU_OPS_AGENT_TOKEN=replace-with-a-second-random-application-key
BINHU_BACKUP_DIR=./backups
BINHU_WORKFLOW_ATTACHMENT_DIR=/data/binhu/workflow-attachments
BINHU_WORKFLOW_PHOTO_IMPORT_DIR=/data/binhu/workflow-photo-imports

# Required only by the remote deployment helper scripts.
BINHU_SSH_HOST=your-server.example.com
BINHU_SSH_PORT=22
BINHU_SSH_USER=root
BINHU_SSH_PASSWORD=replace-with-your-ssh-password
BINHU_LOCAL_BASE=.
