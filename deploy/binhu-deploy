#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ -r /etc/binhu-deploy.conf ]] && source /etc/binhu-deploy.conf
: "${BINHU_PROJECT_DIR:=/root/binhu}"
: "${BINHU_DEPLOY_STATE_DIR:=/var/lib/binhu-deploy}"
: "${BINHU_DEPLOY_MIN_FREE_KB:=1048576}"
: "${BINHU_DEPLOY_MAX_BUNDLE_BYTES:=134217728}"
: "${BINHU_DEPLOY_MAX_HOTFIX_BUNDLE_BYTES:=1073741824}"
: "${BINHU_DEPLOY_PUBLIC_URL:=}"

log() {
  printf '[binhu-deploy] %s\n' "$*"
}

fail() {
  printf '[binhu-deploy] ERROR: %s\n' "$*" >&2
  if declare -F rollback_after_error >/dev/null \
    && [[ "${switched:-0}" -eq 1 ]]; then
    rollback_after_error 1 "${BASH_LINENO[0]:-0}"
  fi
  exit 1
}

if [[ "${1:-}" == "status" ]]; then
  [[ $# -eq 1 ]] || fail "status does not accept arguments"
  readonly status_project_dir="$(readlink -f "$BINHU_PROJECT_DIR")"
  readonly status_state_dir="$(readlink -m "$BINHU_DEPLOY_STATE_DIR")"
  [[ -f "$status_project_dir/VERSION" ]] || fail "current VERSION is missing"
  status_version="$(tr -d '\r\n' < "$status_project_dir/VERSION")"
  status_commit="$(python3 - "$status_state_dir/current.json" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
commit = "unknown"
try:
    payload = json.loads(path.read_text(encoding="utf-8"))
    candidate = str(payload.get("commit") or "")
    if re.fullmatch(r"[0-9a-f]{40}", candidate):
        commit = candidate
except (OSError, ValueError, TypeError):
    pass
print(commit)
PY
)"
  printf 'DEPLOY_RESULT=status\n'
  printf 'DEPLOY_VERSION=%s\n' "$status_version"
  printf 'DEPLOY_COMMIT=%s\n' "$status_commit"
  exit 0
fi

if [[ "${1:-}" == "hotfix" ]]; then
  [[ $# -eq 8 ]] || fail "hotfix requires version, commit, all scope, bundle size, id and digest"
  readonly hotfix_version="$2"
  readonly hotfix_commit="$3"
  readonly hotfix_backup_scope="$4"
  readonly hotfix_release_scope="$5"
  readonly hotfix_bundle_bytes="$6"
  readonly hotfix_id="$7"
  readonly hotfix_bundle_sha256="$8"
  [[ "$hotfix_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid hotfix version"
  [[ "$hotfix_commit" =~ ^[0-9a-f]{40}$ ]] || fail "invalid hotfix commit"
  [[ "$hotfix_backup_scope" == all && "$hotfix_release_scope" == backend ]] \
    || fail "hotfix requires all-database backup and backend-only release"
  [[ "$hotfix_bundle_bytes" =~ ^[1-9][0-9]{0,9}$ ]] \
    && (( hotfix_bundle_bytes <= BINHU_DEPLOY_MAX_HOTFIX_BUNDLE_BYTES )) || fail "invalid hotfix bundle size"
  [[ "$hotfix_id" =~ ^HF-[0-9]{8}-[0-9]{1,6}$ ]] || fail "invalid hotfix id"
  [[ "$hotfix_bundle_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "invalid hotfix bundle digest"
  [[ "$BINHU_DEPLOY_STATE_DIR" == /var/lib/binhu-deploy ]] || fail "unexpected deployment state directory"
  exec 9>"/run/lock/binhu-deploy.lock"
  flock -n 9 || fail "another deployment is already running"
  export BINHU_DEPLOY_LOCK_HELD=1
  exec "$0" internal-hotfix-bundle "$hotfix_version" "$hotfix_commit" \
    "$hotfix_backup_scope" "$hotfix_release_scope" "$hotfix_bundle_bytes" "$hotfix_id" "$hotfix_bundle_sha256"
fi

if [[ "${1:-}" == "promote" ]]; then
  [[ $# -eq 6 ]] || fail "promote requires Staging run, commit and Compose identity"
  readonly promotion_version="$2"
  readonly promotion_run_id="$3"
  readonly promotion_commit="$4"
  readonly promotion_compose_sha256="$5"
  readonly promotion_compose_bytes="$6"
  [[ "$promotion_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid promotion version"
  [[ "$promotion_run_id" =~ ^staging-app-[0-9a-f]{16}$ ]] || fail "invalid Staging run id"
  [[ "$promotion_commit" =~ ^[0-9a-f]{40}$ ]] || fail "invalid promotion commit"
  [[ "$promotion_compose_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "invalid production Compose digest"
  [[ "$promotion_compose_bytes" =~ ^[1-9][0-9]{0,6}$ ]] \
    && (( promotion_compose_bytes <= 1048576 )) || fail "invalid production Compose size"
  [[ "$BINHU_DEPLOY_STATE_DIR" == /var/lib/binhu-deploy ]] || fail "unexpected deployment state directory"
  exec 9>"/run/lock/binhu-deploy.lock"
  flock -n 9 || fail "another deployment is already running"
  install -d -o root -g root -m 0750 "$BINHU_DEPLOY_STATE_DIR/incoming"
  readonly compose_input="$(mktemp "$BINHU_DEPLOY_STATE_DIR/incoming/compose.XXXXXX")"
  trap 'rm -f -- "$compose_input"' EXIT
  head -c "$promotion_compose_bytes" > "$compose_input"
  [[ "$(wc -c < "$compose_input")" == "$promotion_compose_bytes" ]] || fail "incomplete production Compose input"
  promotion_result="$(PYTHONPATH=/usr/local/lib/binhu-deploy python3 -m deploy.environments.production_promotion \
    "$promotion_run_id" "$promotion_commit" "$promotion_version" \
    "$compose_input" "$promotion_compose_sha256")" || fail "accepted Staging promotion validation failed"
  promotion_artifact_id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["artifact_id"])' "$promotion_result")"
  promotion_artifact_sha256="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["artifact_manifest_sha256"])' "$promotion_result")"
  promotion_image_id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["image_id"])' "$promotion_result")"
  readonly promotion_bundle="$BINHU_DEPLOY_STATE_DIR/candidates/$promotion_run_id/production-release.tar.gz"
  [[ -f "$promotion_bundle" ]] || fail "promotion bundle was not created"
  readonly promotion_bundle_bytes="$(wc -c < "$promotion_bundle")"
  [[ "$promotion_bundle_bytes" =~ ^[1-9][0-9]{0,8}$ ]] \
    && (( promotion_bundle_bytes <= BINHU_DEPLOY_MAX_BUNDLE_BYTES )) || fail "promotion bundle exceeds size limit"
  rm -f -- "$compose_input"
  trap - EXIT
  export BINHU_DEPLOY_LOCK_HELD=1
  exec "$0" internal-bundle "$promotion_version" "$promotion_commit" \
    "$promotion_image_id" "$promotion_run_id" "$promotion_artifact_id" \
    "$promotion_artifact_sha256" "$promotion_compose_sha256" "$promotion_bundle_bytes" \
    < "$promotion_bundle"
fi

if [[ "${1:-}" == "production-maintenance" ]]; then
  [[ $# -ge 4 && $# -le 9 ]] || fail "production-maintenance requires operation, phase and run id"
  [[ -x /usr/local/sbin/binhu-maintenance ]] || fail "production maintenance contract is not installed"
  exec /usr/local/sbin/binhu-maintenance "${@:2}"
fi

if [[ "${1:-}" == "current-flow-cleanup" ]]; then
  [[ $# -eq 4 ]] || fail "current-flow-cleanup requires phase, run id and business date"
  readonly cleanup_phase="$2"
  readonly cleanup_run_id="$3"
  readonly cleanup_business_date="$4"
  case "$cleanup_phase" in
    measure|backup-check|prepare|apply|verify) ;;
    *) fail "invalid current-flow-cleanup phase" ;;
  esac
  [[ "$cleanup_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$ ]] || fail "invalid cleanup run id"
  [[ "$cleanup_business_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "invalid cleanup business date"
  [[ -f "$BINHU_PROJECT_DIR/backend/migrations/current_flow_cleanup.py" ]] || fail "cleanup tool is not installed"
  exec docker exec \
    -e BINHU_CLEANUP_EVIDENCE_ROOT=/srv/binhu-release-evidence-current-flow-cleanup \
    -e BINHU_DEPLOY_BACKUP_ROOT="$BINHU_PROJECT_DIR/deploy-backups/automated" \
    binhu-backend python -m migrations.current_flow_cleanup \
    "$cleanup_phase" "$cleanup_run_id" "$cleanup_business_date"
fi

release_kind="staging-promotion"
promotion_image_id=""
promotion_run_id=""
promotion_artifact_id=""
promotion_artifact_sha256=""
promotion_compose_sha256=""
hotfix_id=""
if [[ "${1:-}" == "internal-bundle" ]]; then
  [[ "${EUID:-$(id -u)}" -eq 0 && "${BINHU_DEPLOY_LOCK_HELD:-}" == 1 && $# -eq 9 ]] \
    || fail "invalid internal promotion invocation"
  release_kind="staging-promotion"
  readonly release_version="$2"
  readonly release_commit="$3"
  promotion_image_id="$4"
  promotion_run_id="$5"
  promotion_artifact_id="$6"
  promotion_artifact_sha256="$7"
  promotion_compose_sha256="$8"
  readonly backup_scope="all"
  readonly release_scope="full"
  readonly expected_bundle_size="$9"
elif [[ "${1:-}" == "internal-hotfix-bundle" ]]; then
  [[ "${EUID:-$(id -u)}" -eq 0 && "${BINHU_DEPLOY_LOCK_HELD:-}" == 1 && $# -eq 8 ]] \
    || fail "invalid internal hotfix invocation"
  release_kind="hotfix"
  readonly release_version="$2"
  readonly release_commit="$3"
  readonly backup_scope="$4"
  readonly release_scope="$5"
  readonly expected_bundle_size="$6"
  hotfix_id="$7"
  hotfix_bundle_sha256="$8"
  [[ "$backup_scope" == all && "$release_scope" == backend ]] || fail "invalid hotfix release scope"
  [[ "$hotfix_id" =~ ^HF-[0-9]{8}-[0-9]{1,6}$ ]] || fail "invalid hotfix id"
  [[ "$hotfix_bundle_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "invalid hotfix bundle digest"
else
  fail "only accepted Staging promotions or fixed hotfix bundles may enter Production"
fi
if [[ "$release_kind" == "staging-promotion" ]]; then
  [[ "$promotion_image_id" =~ ^sha256:[0-9a-f]{64}$ \
    && "$promotion_run_id" =~ ^staging-app-[0-9a-f]{16}$ \
    && "$promotion_artifact_id" =~ ^[0-9a-f]{64}$ \
    && "$promotion_artifact_sha256" =~ ^[0-9a-f]{64}$ \
    && "$promotion_compose_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "invalid promotion identity"
fi
[[ "$release_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid version"
[[ "$release_commit" =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit"
if [[ "$release_kind" == "staging-promotion" ]]; then
  [[ "$backup_scope" == all && "$release_scope" == full ]] || fail "Production promotion requires all/full"
else
  [[ "$backup_scope" == all && "$release_scope" == backend ]] || fail "hotfix requires all/backend scope"
fi
if [[ "$release_kind" == "hotfix" ]]; then
  [[ "$expected_bundle_size" =~ ^[1-9][0-9]{0,9}$ ]] \
    && (( expected_bundle_size <= BINHU_DEPLOY_MAX_HOTFIX_BUNDLE_BYTES )) || fail "hotfix bundle exceeds size limit"
else
  [[ "$expected_bundle_size" =~ ^[1-9][0-9]{0,8}$ ]] \
    && (( expected_bundle_size <= BINHU_DEPLOY_MAX_BUNDLE_BYTES )) || fail "release bundle exceeds size limit"
fi

for command_name in docker curl python3 tar gzip sha256sum flock head awk \
  readlink install date mktemp wc df grep seq sleep cp rm; do
  command -v "$command_name" >/dev/null 2>&1 || fail "missing command: $command_name"
done

readonly project_dir="$(readlink -f "$BINHU_PROJECT_DIR")"
readonly state_dir="$(readlink -m "$BINHU_DEPLOY_STATE_DIR")"
[[ -d "$project_dir" && -f "$project_dir/docker-compose.yml" ]] || fail "invalid project directory"
[[ -f "$project_dir/.env" ]] || fail "production .env is missing"
[[ "$state_dir" == /var/lib/binhu-deploy ]] || fail "unexpected deployment state directory"
[[ "$BINHU_DEPLOY_PUBLIC_URL" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] \
  || fail "invalid or missing public health URL"

install -d -o root -g root -m 0750 "$state_dir/incoming" "$state_dir/work" \
  "$state_dir/releases" "$state_dir/history"
if [[ "${BINHU_DEPLOY_LOCK_HELD:-}" != 1 ]]; then
  exec 9>"/run/lock/binhu-deploy.lock"
  flock -n 9 || fail "another deployment is already running"
fi

readonly started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
readonly timestamp="$(date -u +%Y%m%d_%H%M%S)"
readonly short_commit="${release_commit:0:12}"
readonly release_id="${release_version}-${short_commit}-${timestamp}"
readonly incoming_bundle="$(mktemp "$state_dir/incoming/${release_id}.XXXXXX.tar.gz")"
readonly work_dir="$(mktemp -d "$state_dir/work/${release_id}.XXXXXX")"
readonly release_dir="$state_dir/releases/$release_id"
switched=0
program_backup=""
rollback_tag=""
candidate_tag=""
previous_version=""
timing_receive=0
timing_validate=0
timing_preflight=0
timing_image_load=0
timing_image_build=0
timing_program_backup=0
timing_database_backup=0
timing_switch_files=0
timing_container_recreate=0
timing_health_checks=0
backup_id=""
hotfix_id="${hotfix_id:-}"
hotfix_bundle_sha256="${hotfix_bundle_sha256:-}"

cleanup() {
  [[ "$incoming_bundle" == "$state_dir/incoming/"* ]] \
    || fail "unsafe incoming cleanup target"
  [[ "$work_dir" == "$state_dir/work/"* ]] \
    || fail "unsafe work cleanup target"
  rm -f -- "$incoming_bundle"
  rm -rf -- "$work_dir"
}
trap cleanup EXIT

write_history() {
  local status="$1"
  local finished_at
  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  python3 - "$state_dir/history/${release_id}.json" "$status" <<PY
import json
import sys
from pathlib import Path

target = Path(sys.argv[1])
payload = {
    "schema": 2,
    "status": sys.argv[2],
    "version": "$release_version",
    "commit": "$release_commit",
    "backup_scope": "$backup_scope",
    "release_scope": "$release_scope",
    "previous_version": "$previous_version",
    "started_at": "$started_at",
    "finished_at": "$finished_at",
    "release_dir": "$release_dir",
    "release_kind": "$release_kind",
    "hotfix_id": "$hotfix_id",
    "hotfix_bundle_sha256": "$hotfix_bundle_sha256",
    "staging_run_id": "$promotion_run_id",
    "artifact_id": "$promotion_artifact_id",
    "image_id": "$promotion_image_id",
    "production_compose_sha256": "$promotion_compose_sha256",
    "backup_id": "$backup_id",
    "program_backup": "$program_backup",
    "rollback_image": "$rollback_tag",
    "timings_seconds": {
        "receive": $timing_receive,
        "validate_extract": $timing_validate,
        "preflight": $timing_preflight,
        "image_load": $timing_image_load,
        "image_build": $timing_image_build,
        "program_backup": $timing_program_backup,
        "database_backup": $timing_database_backup,
        "switch_files": $timing_switch_files,
        "container_recreate": $timing_container_recreate,
        "health_checks": $timing_health_checks,
    },
}
target.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
  if [[ "$status" == "success" ]]; then
    cp -f "$state_dir/history/${release_id}.json" "$state_dir/current.json"
  fi
}

rollback_after_error() {
  local exit_code="$1"
  local line_number="$2"
  trap - ERR
  set +e
  log "deployment failed at line ${line_number}; starting application rollback"
  if [[ "$switched" -eq 1 && -n "$program_backup" ]]; then
    if [[ "$release_scope" != "frontend" ]]; then
      rm -rf -- "$project_dir/backend"
    fi
    if [[ "$release_scope" != "backend" ]]; then
      rm -rf -- "$project_dir/frontend/dist"
    fi
    tar -xzf "$program_backup" -C "$project_dir"
    if [[ -n "$rollback_tag" ]]; then
      docker tag "$rollback_tag" binhu-backend:latest
    fi
    (
      cd "$project_dir"
      if [[ "$release_kind" == "hotfix" ]]; then
        docker compose up -d --no-build --no-deps --force-recreate ops-agent backend
      else
        docker compose up -d --no-build --no-deps --force-recreate ops-agent backend event-relay diagnostic-worker
      fi
    )
    for _ in $(seq 1 45); do
      if curl -fsS http://127.0.0.1:37125/api/health 2>/dev/null \
        | grep -q "\"version\":\"${previous_version}\""; then
        log "rollback restored version ${previous_version}"
        break
      fi
      sleep 2
    done
  fi
  write_history "failed" || true
  exit "$exit_code"
}
trap 'rollback_after_error "$?" "$LINENO"' ERR

receive_started="$(date +%s)"
log "receiving ${release_scope} release ${release_version} (${short_commit}), ${expected_bundle_size} bytes"
head -c "$expected_bundle_size" > "$incoming_bundle"
bundle_size="$(wc -c < "$incoming_bundle")"
[[ "$bundle_size" == "$expected_bundle_size" ]] || fail "incomplete release bundle"
if [[ "$release_kind" == "hotfix" ]]; then
  [[ "$(sha256sum "$incoming_bundle" | awk '{print $1}')" == "$hotfix_bundle_sha256" ]] \
    || fail "hotfix bundle digest mismatch"
fi
timing_receive=$(( $(date +%s) - receive_started ))
log "release received in ${timing_receive}s"

validate_started="$(date +%s)"
python3 - "$incoming_bundle" <<'PY'
import sys
import tarfile
from pathlib import PurePosixPath

allowed_sets = (
    {"source.tar.gz", "manifest.json", "SHA256SUMS"},
    {"source.tar.gz", "frontend-dist.tar.gz", "manifest.json", "SHA256SUMS"},
    {"source.tar.gz", "image.tar.gz", "candidate.json", "manifest.json", "SHA256SUMS"},
)
with tarfile.open(sys.argv[1], "r:gz") as archive:
    members = archive.getmembers()
    names = {member.name for member in members}
    if names not in allowed_sets or len(members) != len(names):
        raise SystemExit("unexpected release bundle contents")
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts or not member.isfile():
            raise SystemExit("unsafe release bundle member")
PY
tar -xzf "$incoming_bundle" -C "$work_dir"

python3 - "$work_dir/manifest.json" "$work_dir/SHA256SUMS" \
  "$release_version" "$release_commit" "$backup_scope" "$release_scope" \
  "$promotion_run_id" "$promotion_artifact_id" "$promotion_artifact_sha256" \
  "$promotion_image_id" "$promotion_compose_sha256" "$hotfix_id" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

manifest_path = Path(sys.argv[1])
checksums_path = Path(sys.argv[2])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
if manifest.get("schema") not in {1, 2, 3}:
    raise SystemExit("unsupported manifest schema")
if manifest.get("version") != sys.argv[3]:
    raise SystemExit("manifest version mismatch")
if manifest.get("commit") != sys.argv[4]:
    raise SystemExit("manifest commit mismatch")
if manifest.get("backup_scope") != sys.argv[5]:
    raise SystemExit("manifest backup scope mismatch")
manifest_scope = manifest.get("release_scope", "full")
if manifest_scope != sys.argv[6]:
    raise SystemExit("manifest release scope mismatch")
if manifest.get("schema") == 3:
    expected_promotion = {
        "backup_scope": "all", "release_scope": "full",
        "release_kind": "staging-promotion",
        "staging_run_id": sys.argv[7], "artifact_id": sys.argv[8],
        "artifact_manifest_sha256": sys.argv[9], "image_id": sys.argv[10],
        "commit": sys.argv[4], "version": sys.argv[3],
        "production_config_commit": sys.argv[4],
        "production_compose_sha256": sys.argv[11],
    }
    if any(manifest.get(key) != value for key, value in expected_promotion.items()):
        raise SystemExit("Staging promotion manifest identity mismatch")
    expected_files = {"source.tar.gz", "frontend-dist.tar.gz"}
elif manifest.get("schema") == 2 and manifest.get("release_kind") == "hotfix":
    if (manifest.get("commit") != sys.argv[4] or manifest.get("version") != sys.argv[3]
            or manifest.get("backup_scope") != "all" or manifest.get("release_scope") != "backend"
            or manifest.get("hotfix_id") != sys.argv[12]
            or manifest.get("ready_for_hotfix") is not True):
        raise SystemExit("hotfix release identity mismatch")
    candidate_path = manifest_path.parent / "candidate.json"
    candidate_digest = hashlib.sha256(candidate_path.read_bytes()).hexdigest()
    candidate = json.loads(candidate_path.read_text(encoding="utf-8"))
    if candidate_digest != manifest.get("candidate_manifest_sha256"):
        raise SystemExit("hotfix candidate manifest digest mismatch")
    if (candidate.get("schema") != 1 or candidate.get("commit") != sys.argv[4]
            or candidate.get("version") != sys.argv[3]
            or candidate.get("release_scope") != "backend"
            or candidate.get("ready_for_hotfix") is not True
            or candidate.get("artifact_id") != manifest.get("artifact_id")
            or candidate.get("image_id") != manifest.get("image_id")):
        raise SystemExit("hotfix candidate identity mismatch")
    expected_files = {"source.tar.gz", "image.tar.gz", "candidate.json"}
    if set(manifest.get("files", {})) != expected_files:
        raise SystemExit("hotfix candidate file list mismatch")
    source_digest = hashlib.sha256((manifest_path.parent / "source.tar.gz").read_bytes()).hexdigest()
    if (source_digest != candidate.get("artifact_id")
            or source_digest != candidate.get("files", {}).get("source.tar.gz", {}).get("sha256")):
        raise SystemExit("hotfix source artifact digest mismatch")
    image_metadata = candidate.get("files", {}).get("image.tar.gz", {})
    if image_metadata != manifest.get("files", {}).get("image.tar.gz"):
        raise SystemExit("hotfix image archive metadata mismatch")
else:
    raise SystemExit("Production bundle is neither an accepted Staging promotion nor a fixed hotfix")
checksum_lines = checksums_path.read_text(encoding="ascii").splitlines()
if manifest_scope in {"frontend", "full"}:
    expected_files.add("frontend-dist.tar.gz")
checksum_pattern = re.compile(r"^([0-9a-f]{64})  ([a-z-]+(?:\.tar\.gz|\.json))$")
checksums = {}
for line in checksum_lines:
    match = checksum_pattern.fullmatch(line)
    if not match or match.group(2) in checksums:
        raise SystemExit("invalid checksum list")
    checksums[match.group(2)] = match.group(1)
if set(checksums) != expected_files or set(manifest.get("files", {})) != expected_files:
    raise SystemExit("incomplete checksum list")
for filename in sorted(expected_files):
    path = manifest_path.parent / filename
    metadata = manifest.get("files", {}).get(filename, {})
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if (
        metadata.get("sha256") != digest
        or checksums[filename] != digest
        or metadata.get("size") != path.stat().st_size
    ):
        raise SystemExit(f"manifest file mismatch: {filename}")
PY

validate_inner_archive() {
  python3 - "$1" "$2" "$3" <<'PY'
import sys
import tarfile
from pathlib import PurePosixPath

with tarfile.open(sys.argv[1], "r:gz") as archive:
    members = archive.getmembers()
    size_limit = 64 * 1024 * 1024 if sys.argv[2] == "source" else 128 * 1024 * 1024
    if len(members) > 20000 or sum(member.size for member in members) > size_limit:
        raise SystemExit("archive exceeds extraction limits")
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit("unsafe archive path")
        if member.isdev() or member.isfifo() or member.issym() or member.islnk():
            raise SystemExit("links and special files are not allowed")
        if sys.argv[2] == "source" and any(
            part in {".env", ".git", "AGENTS.local.md"} for part in path.parts
        ):
            raise SystemExit("source archive contains a private path")
        if sys.argv[2] == "source" and path.parts[:2] == ("frontend", "dist"):
            raise SystemExit("source archive cannot contain built frontend files")
        if sys.argv[2] == "source" and sys.argv[3] == "backend":
