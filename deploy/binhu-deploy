    "schema": 1,
    "created_at": datetime.now(timezone.utc).isoformat(),
    "backup_scope": sys.argv[2],
    "release_scope": sys.argv[3],
    "databases": databases,
}
(root / "backup-manifest.json").write_text(
    json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
