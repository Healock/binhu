#!/usr/bin/env bash
set -euo pipefail

readonly command_text="${SSH_ORIGINAL_COMMAND:-}"
read -r -a command_parts <<<"$command_text"

if [[ "${command_parts[0]:-}" == "status" && "${#command_parts[@]}" -eq 1 ]]; then
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy status
fi

# Production data maintenance is limited to the two explicitly registered
# retirement tools. The root-owned deploy script validates every argument again.
if [[ "${command_parts[0]:-}" == "production-maintenance" ]]; then
  [[ "${#command_parts[@]}" -ge 4 && "${#command_parts[@]}" -le 6 ]] || {
    echo "Invalid production-maintenance argument count." >&2; exit 64;
  }
  readonly maintenance_operation="${command_parts[1]}"
  readonly maintenance_phase="${command_parts[2]}"
  readonly maintenance_run_id="${command_parts[3]}"
  case "$maintenance_operation" in
    internal-department-retirement|photo-sheet-retirement) ;;
    *) echo "Invalid production-maintenance operation." >&2; exit 64 ;;
  esac
  case "$maintenance_phase" in
    measure|backup|apply|verify) ;;
    *) echo "Invalid production-maintenance phase." >&2; exit 64 ;;
  esac
  [[ "$maintenance_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$ ]] || {
    echo "Invalid production-maintenance run id." >&2; exit 64;
  }
  if [[ "$maintenance_phase" == "apply" ]]; then
    [[ "${#command_parts[@]}" -eq 6 && "${command_parts[4]}" =~ ^[0-9]+$ ]] || {
      echo "Apply requires an expected count and confirmation token." >&2; exit 64;
    }
    case "$maintenance_operation:${command_parts[5]}" in
      internal-department-retirement:confirm-remove-internal|photo-sheet-retirement:confirm-empty-photo-tables) ;;
      *) echo "Invalid production-maintenance confirmation." >&2; exit 64 ;;
    esac
  else
    [[ "${#command_parts[@]}" -eq 4 ]] || {
      echo "This production-maintenance phase takes no extra arguments." >&2; exit 64;
    }
  fi
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy \
    production-maintenance "${command_parts[@]:1}"
fi

# 生产当前任务维护只允许通过固定的五阶段合同进入。业务类型由已部署
# 工具从 TASK_WORKFLOWS 固定清单解析，网关不接受任意表名或 SQL。
if [[ "${command_parts[0]:-}" == "current-flow-cleanup" && "${#command_parts[@]}" -eq 4 ]]; then
  readonly cleanup_phase="${command_parts[1]}"
  readonly cleanup_run_id="${command_parts[2]}"
  readonly cleanup_business_date="${command_parts[3]}"
  case "$cleanup_phase" in
    measure|backup-check|prepare|apply|verify) ;;
    *) echo "Invalid current-flow-cleanup phase." >&2; exit 64 ;;
  esac
  [[ "$cleanup_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$ ]] || { echo "Invalid cleanup run id." >&2; exit 64; }
  [[ "$cleanup_business_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "Invalid cleanup business date." >&2; exit 64; }
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy \
    current-flow-cleanup "$cleanup_phase" "$cleanup_run_id" "$cleanup_business_date"
fi

if [[ "${command_parts[0]:-}" == "hotfix" && "${#command_parts[@]}" -eq 7 ]]; then
  readonly version="${command_parts[1]}"; readonly commit="${command_parts[2]}"
  readonly backup_scope="${command_parts[3]}"; readonly release_scope="${command_parts[4]}"
  readonly bundle_size="${command_parts[5]}"; readonly hotfix_id="${command_parts[6]}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Invalid version." >&2; exit 64; }
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid commit." >&2; exit 64; }
  [[ "$backup_scope" == online && "$release_scope" == backend ]] || { echo "Invalid hotfix scope." >&2; exit 64; }
  [[ "$hotfix_id" =~ ^HF-[0-9]{8}-[0-9]{1,6}$ ]] || { echo "Invalid hotfix id." >&2; exit 64; }
  [[ "$bundle_size" =~ ^[1-9][0-9]{0,8}$ ]] && (( bundle_size <= 134217728 )) || { echo "Invalid bundle size." >&2; exit 64; }
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy hotfix "$version" "$commit" "$backup_scope" "$release_scope" "$bundle_size" "$hotfix_id"
fi
if [[ "${command_parts[0]:-}" != "deploy" || "${#command_parts[@]}" -ne 6 ]]; then
  echo "Only the fixed Binhu deploy command is allowed." >&2
  exit 64
fi
readonly version="${command_parts[1]}"
readonly commit="${command_parts[2]}"
readonly backup_scope="${command_parts[3]}"
readonly release_scope="${command_parts[4]}"
readonly bundle_size="${command_parts[5]}"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Invalid version." >&2
  exit 64
fi
if [[ ! "$commit" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Invalid commit." >&2
  exit 64
fi
case "$backup_scope" in
  none|online|daily|all) ;;
  *)
    echo "Invalid backup scope." >&2
    exit 64
    ;;
esac
case "$release_scope" in
  backend|frontend|full) ;;
  *)
    echo "Invalid release scope." >&2
    exit 64
    ;;
esac
if [[ ! "$bundle_size" =~ ^[1-9][0-9]{0,8}$ ]] \
  || (( bundle_size > 134217728 )); then
  echo "Invalid bundle size." >&2
  exit 64
fi

exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy \
  "$version" "$commit" "$backup_scope" "$release_scope" "$bundle_size"
