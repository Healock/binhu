#!/usr/bin/env bash
set -euo pipefail

readonly command_text="${SSH_ORIGINAL_COMMAND:-}"
read -r -a command_parts <<<"$command_text"

if [[ "${command_parts[0]:-}" == "status" && "${#command_parts[@]}" -eq 1 ]]; then
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy status
fi

# Production data maintenance is limited to fixed, registered operations. The
# root-owned deploy script validates every argument again.
if [[ "${command_parts[0]:-}" == "production-maintenance" ]]; then
  [[ "${#command_parts[@]}" -ge 4 && "${#command_parts[@]}" -le 9 ]] || {
    echo "Invalid production-maintenance argument count." >&2; exit 64;
  }
  readonly maintenance_operation="${command_parts[1]}"
  readonly maintenance_phase="${command_parts[2]}"
  readonly maintenance_run_id="${command_parts[3]}"
  case "$maintenance_operation" in
    internal-department-retirement|photo-sheet-retirement|registry-property-identity|venue-photo-recovery) ;;
    *) echo "Invalid production-maintenance operation." >&2; exit 64 ;;
  esac
  case "$maintenance_phase" in
    measure|backup|apply|verify|rollback) ;;
    *) echo "Invalid production-maintenance phase." >&2; exit 64 ;;
  esac
  [[ "$maintenance_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$ ]] || {
    echo "Invalid production-maintenance run id." >&2; exit 64;
  }
  if [[ "$maintenance_operation" == "registry-property-identity" ]]; then
    valid_property_id() {
      [[ "$1" =~ ^[1-9][0-9]{0,18}$ ]] &&
        python3 -c 'import sys; sys.exit(0 if int(sys.argv[1]) <= 9223372036854775807 else 1)' "$1"
    }
    valid_actor() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,99}$ ]]; }
    case "$maintenance_phase" in
      measure|verify)
        [[ "${#command_parts[@]}" -eq 7 ]] && valid_property_id "${command_parts[4]}" && \
          valid_property_id "${command_parts[5]}" && valid_actor "${command_parts[6]}" || {
          echo "Measure and verify require property ids and an actor id." >&2; exit 64;
        }
        ;;
      backup)
        [[ "${#command_parts[@]}" -eq 5 ]] && valid_actor "${command_parts[4]}" || {
          echo "Backup requires an actor id." >&2; exit 64;
        }
        ;;
      apply|rollback)
        [[ "${#command_parts[@]}" -eq 9 ]] && valid_property_id "${command_parts[4]}" && \
          valid_property_id "${command_parts[5]}" && [[ "${command_parts[6]}" =~ ^[0-9a-f]{64}$ ]] && \
          valid_actor "${command_parts[8]}" || {
          echo "Apply and rollback require property ids, a measurement hash and an actor id." >&2; exit 64;
        }
        case "$maintenance_phase:${command_parts[7]}" in
          apply:confirm-registry-property-identity|rollback:confirm-registry-property-identity-rollback) ;;
          *) echo "Invalid registry identity confirmation." >&2; exit 64 ;;
        esac
        ;;
    esac
  elif [[ "$maintenance_operation" == "venue-photo-recovery" ]]; then
    [[ "$maintenance_phase" != rollback ]] || { echo "Venue photo recovery has no rollback phase." >&2; exit 64; }
    if [[ "$maintenance_phase" == apply ]]; then
      [[ "${#command_parts[@]}" -eq 7 && "${command_parts[4]}" =~ ^[0-9]+$ && "${command_parts[5]}" =~ ^[0-9a-f]{64}$ ]] || {
        echo "Apply requires an expected count, measurement hash and confirmation token." >&2; exit 64;
      }
      [[ "${command_parts[6]}" == confirm-venue-photo-recovery ]] || {
        echo "Invalid venue photo recovery confirmation." >&2; exit 64;
      }
    else
      [[ "${#command_parts[@]}" -eq 4 ]] || {
        echo "This production-maintenance phase takes no extra arguments." >&2; exit 64;
      }
    fi
  else
    [[ "$maintenance_phase" != rollback ]] || { echo "Rollback is only registered for registry identity maintenance." >&2; exit 64; }
    if [[ "$maintenance_phase" == apply ]]; then
      [[ "${#command_parts[@]}" -eq 6 && "${command_parts[4]}" =~ ^[0-9]+$ ]] || {
        echo "Apply requires an expected count and confirmation token." >&2; exit 64;
      }
      case "$maintenance_operation:${command_parts[5]}" in
        internal-department-retirement:confirm-remove-internal|photo-sheet-retirement:confirm-empty-photo-tables) ;;
        *) echo "Invalid production-maintenance confirmation." >&2; exit 64 ;;
      esac
    else
      [[ "${#command_parts[@]}" -eq 4 ]] || {
        echo "This production-maintenance phase takes no extra arguments." >&2; exit 64;
      }
    fi
  fi
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy \
    production-maintenance "${command_parts[@]:1}"
fi

# 生产当前任务维护只允许通过固定的五阶段合同进入。业务类型由已部署
# 工具从 TASK_WORKFLOWS 固定清单解析，网关不接受任意表名或 SQL。
if [[ "${command_parts[0]:-}" == "current-flow-cleanup" && "${#command_parts[@]}" -eq 4 ]]; then
  readonly cleanup_phase="${command_parts[1]}"
  readonly cleanup_run_id="${command_parts[2]}"
  readonly cleanup_business_date="${command_parts[3]}"
  case "$cleanup_phase" in
    measure|backup-check|prepare|apply|verify) ;;
    *) echo "Invalid current-flow-cleanup phase." >&2; exit 64 ;;
  esac
  [[ "$cleanup_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$ ]] || { echo "Invalid cleanup run id." >&2; exit 64; }
  [[ "$cleanup_business_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "Invalid cleanup business date." >&2; exit 64; }
  exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy \
    current-flow-cleanup "$cleanup_phase" "$cleanup_run_id" "$cleanup_business_date"
fi

if [[ "${command_parts[0]:-}" != "promote" || "${#command_parts[@]}" -ne 6 ]]; then
  echo "Only accepted Staging promotions are allowed in Production." >&2
  exit 64
fi
readonly version="${command_parts[1]}"
readonly staging_run_id="${command_parts[2]}"
readonly commit="${command_parts[3]}"
readonly compose_sha256="${command_parts[4]}"
readonly compose_size="${command_parts[5]}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "Invalid version." >&2
  exit 64
}
[[ "$staging_run_id" =~ ^staging-app-[0-9a-f]{16}$ ]] || {
  echo "Invalid Staging run id." >&2
  exit 64
}
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || {
  echo "Invalid commit." >&2
  exit 64
}
[[ "$compose_sha256" =~ ^[0-9a-f]{64}$ ]] || {
  echo "Invalid Production Compose digest." >&2
  exit 64
}
[[ "$compose_size" =~ ^[1-9][0-9]{0,6}$ ]] && (( compose_size <= 1048576 )) || {
  echo "Invalid Production Compose size." >&2
  exit 64
}

exec /usr/bin/sudo -n /usr/local/sbin/binhu-deploy \
  promote "$version" "$staging_run_id" "$commit" "$compose_sha256" "$compose_size"
