#!/usr/bin/env bash
set -euo pipefail
read -r -a parts <<< "${SSH_ORIGINAL_COMMAND:-}"
case "${parts[0]:-}" in
  status)
    [[ ${#parts[@]} -eq 1 ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-dev-application-gateway status ;;
  prepare)
    [[ ${#parts[@]} -eq 5 ]] || exit 64
    [[ "${parts[1]}" =~ ^dev-update-[0-9a-f]{16}$ && "${parts[2]}" =~ ^[0-9a-f]{40}$ && "${parts[3]}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "${parts[4]}" =~ ^[0-9a-f]{64}$ ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-dev-application-gateway prepare "${parts[1]}" "${parts[2]}" "${parts[3]}" "${parts[4]}" ;;
  measure|apply|accept)
    [[ ${#parts[@]} -eq 3 ]] || exit 64
    [[ "${parts[1]}" =~ ^dev-update-[0-9a-f]{16}$ && "${parts[2]}" =~ ^[0-9a-f]{64}$ ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-dev-application-gateway "${parts[0]}" "${parts[1]}" "${parts[2]}" ;;
  *) echo 'fixed Dev application prepare/measure/apply/accept contract required' >&2; exit 64 ;;
esac
