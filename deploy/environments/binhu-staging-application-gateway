#!/usr/bin/env bash
set -euo pipefail
command_line="${SSH_ORIGINAL_COMMAND:-}"
read -r -a parts <<< "$command_line"
case "${parts[0]:-}" in
  status)
    [[ ${#parts[@]} -eq 1 ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-application-gateway status ;;
  prepare)
    [[ ${#parts[@]} -eq 6 ]] || exit 64
    [[ "${parts[1]}" =~ ^staging-app-[0-9a-f]{16}$ && "${parts[2]}" =~ ^[0-9a-f]{40}$ && "${parts[3]}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "${parts[4]}" =~ ^[0-9a-f]{64}$ && "${parts[5]}" =~ ^dev-update-[0-9a-f]{16}$ ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-application-gateway prepare "${parts[1]}" "${parts[2]}" "${parts[3]}" "${parts[4]}" "${parts[5]}" ;;
  measure|apply)
    [[ ${#parts[@]} -eq 3 ]] || exit 64
    [[ "${parts[1]}" =~ ^staging-app-[0-9a-f]{16}$ && "${parts[2]}" =~ ^[0-9a-f]{64}$ ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-application-gateway "${parts[0]}" "${parts[1]}" "${parts[2]}" ;;
  accept)
    [[ ${#parts[@]} -eq 4 ]] || exit 64
    [[ "${parts[1]}" =~ ^staging-app-[0-9a-f]{16}$ && "${parts[2]}" =~ ^[0-9a-f]{64}$ && "${parts[3]}" =~ ^dev-update-[0-9a-f]{16}$ ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-application-gateway accept "${parts[1]}" "${parts[2]}" "${parts[3]}" ;;
  *) echo 'fixed Staging application prepare/measure/apply/accept contract required' >&2; exit 64 ;;
esac
