#!/usr/bin/env bash
set -euo pipefail

parts=()
read -r -a parts <<< "${SSH_ORIGINAL_COMMAND:-}"
case "${parts[0]:-}" in
  status)
    [[ "${#parts[@]}" -eq 1 ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py status
    ;;
  diagnose-measure)
    [[ "${#parts[@]}" -eq 2 && "${parts[1]}" == "STG-20261028-01" ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      diagnose-measure "${parts[1]}"
    ;;
  diagnose-prepare)
    [[ "${#parts[@]}" -eq 2 && "${parts[1]}" == "STG-20261028-02" ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      diagnose-prepare "${parts[1]}"
    ;;
  prepare)
    [[ "${#parts[@]}" -eq 5 ]] || exit 64
    [[ "${parts[1]}" =~ ^STG-[0-9]{8}-[0-9]{2}$ ]] || exit 64
    [[ "${parts[2]}" =~ ^[0-9a-f]{40}$ ]] || exit 64
    [[ "${parts[3]}" =~ ^[1-9][0-9]{0,8}$ ]] || exit 64
    [[ "${parts[4]}" =~ ^[0-9a-f]{64}$ ]] || exit 64
    (( parts[3] <= 134217728 )) || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      prepare "${parts[1]}" "${parts[2]}" "${parts[3]}" "${parts[4]}"
    ;;
  measure|apply|switch|rollback|retire|retire-failed)
    [[ "${#parts[@]}" -eq 2 ]] || exit 64
    [[ "${parts[1]}" =~ ^STG-[0-9]{8}-[0-9]{2}$ ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      "${parts[0]}" "${parts[1]}"
    ;;
  run)
    [[ "${#parts[@]}" -eq 3 ]] || exit 64
    [[ "${parts[1]}" == STG-20261029-02 ]] || exit 64
    [[ "${parts[2]}" =~ ^STG-[0-9]{8}-[0-9]{2}$ ]] || exit 64
    [[ "${parts[2]}" != "${parts[1]}" ]] || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      run "${parts[1]}" "${parts[2]}"
    ;;
  sample)
    [[ "${#parts[@]}" -eq 4 || "${#parts[@]}" -eq 6 ]] || exit 64
    [[ "${parts[1]}" == STG-20261029-02 ]] || exit 64
    [[ "${parts[2]}" =~ ^STG-[0-9]{8}-[0-9]{2}$ && "${parts[2]}" != "${parts[1]}" ]] || exit 64
    [[ "${parts[3]}" =~ ^[1-9][0-9]{9}$ ]] || exit 64
    if [[ "${#parts[@]}" -eq 6 ]]; then
      [[ "${parts[4]}" == production_paused ]] || exit 64
      [[ "${parts[5]}" == PROD-PAUSE-20261029-02 ]] || exit 64
      exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
        sample "${parts[1]}" "${parts[2]}" "${parts[3]}" production_paused "${parts[5]}"
    fi
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      sample "${parts[1]}" "${parts[2]}" "${parts[3]}"
    ;;
  verify)
    [[ "${#parts[@]}" -eq 5 ]] || exit 64
    [[ "${parts[1]}" == STG-20261029-02 ]] || exit 64
    [[ "${parts[2]}" =~ ^STG-[0-9]{8}-[0-9]{2}$ && "${parts[2]}" != "${parts[1]}" ]] || exit 64
    [[ "${parts[3]}" =~ ^[1-9][0-9]{0,7}$ ]] || exit 64
    [[ "${parts[4]}" =~ ^[0-9a-f]{64}$ ]] || exit 64
    (( parts[3] <= 33554432 )) || exit 64
    exec /usr/bin/sudo -n /usr/local/libexec/binhu-staging-event-pipeline-gateway.py \
      verify "${parts[1]}" "${parts[2]}" "${parts[3]}" "${parts[4]}"
    ;;
  *)
    echo 'Only fixed Staging event-pipeline commands are allowed.' >&2
    exit 64
    ;;
esac
