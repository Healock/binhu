[Unit]
Description=YMT Ed25519 token issuer
After=network.target

[Service]
Type=simple
User=ymt-token
Group=ymt-token
WorkingDirectory=/opt/ymt-token
ExecStart=/opt/ymt-token/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 48728 --workers 1
Restart=on-failure
RestartSec=3
UMask=0077
Environment=YMT_TOKEN_KID=zwzz-2026-02
Environment=YMT_TOKEN_ISSUANCE_ENABLED=false
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/ymt-token
ReadOnlyPaths=/etc/ymt/signing-private.pem /etc/ymt/builds.json /etc/ymt/release-public.pem /etc/ymt/release-policy.json /var/www/ymt/release.json /var/www/ymt/ymt-latest.js

[Install]
WantedBy=multi-user.target
