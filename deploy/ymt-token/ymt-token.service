[Unit]
Description=YMT Ed25519 token issuer
After=network.target

[Service]
Type=simple
User=ymt-token
Group=ymt-token
WorkingDirectory=/opt/ymt-token
ExecStart=/opt/ymt-token/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 48728 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/ymt-token
ReadOnlyPaths=/etc/ymt/signing-private.pem /etc/ymt/devices.json

[Install]
WantedBy=multi-user.target
