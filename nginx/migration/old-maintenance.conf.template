server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __BINHU_SERVER_NAME__;
    ssl_certificate /etc/nginx/ssl/binhu/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/binhu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /www/wwwlogs/binhu_access.log;
    error_log /www/wwwlogs/binhu_error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Retry-After 900 always;
    location / {
        default_type text/plain;
        return 503 "Binhu migration maintenance\n";
    }
}
